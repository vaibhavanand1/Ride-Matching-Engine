FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY rider_service/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY proto/ proto/
COPY common/ common/
COPY rider_service/ rider_service/

ENV PYTHONPATH=/app

CMD ["uvicorn", "rider_service.main:app", "--host", "0.0.0.0", "--port", "8000"]
